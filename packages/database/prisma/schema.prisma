datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StockStatus {
  AVAILABLE
  LIMITED
  OUT_OF_STOCK
}

enum UserRole {
  PARTNER
  STAFF
  ACCOUNTANT
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum DeliveryStatus {
  PENDING
  DISPATCHED
  DELIVERED
}

enum EnquirySource {
  WHATSAPP
  CALL
  WEB
}

model Product {
  id                     String           @id @default(uuid())
  code                   String           @unique // e.g. "SF2042"
  name                   String
  brand                  String           // e.g. "Greenlam", "Merino", "Century"
  category               String           @default("LAMINATE") // LAMINATE, PLYWOOD, VENEER
  finish                 String?          // High Gloss, Suede, Texture
  thickness              String?          // 1mm, 0.8mm, 18mm
  size                   String?          @default("8x4 ft")
  publicListPrice        Decimal          @db.Decimal(10, 2)
  stockStatus            StockStatus      @default(AVAILABLE)
  lastPhysicalStockCheck DateTime         @default(now())
  description            String?
  imageUrl               String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  orderItems             SaleOrderItem[]
  auditLogs              StockAuditLog[]

  @@index([code])
  @@index([brand])
  @@index([stockStatus])
}

model CustomerShop {
  id                 String       @id @default(uuid())
  shopName           String
  ownerName          String
  phone              String
  address            String
  marketArea         String?      // Surat market area (Ring Road, Varachha, etc.)
  gstNumber          String?
  creditLimit        Decimal      @default(0.00) @db.Decimal(12, 2)
  outstandingBalance Decimal      @default(0.00) @db.Decimal(12, 2)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  orders             SaleOrder[]

  @@index([shopName])
  @@index([phone])
}

model SaleOrder {
  id               String          @id @default(uuid())
  orderNumber      String          @unique
  shopId           String
  shop             CustomerShop    @relation(fields: [shopId], references: [id])
  orderDate        DateTime        @default(now())
  listAmount       Decimal         @db.Decimal(12, 2)
  negotiatedAmount Decimal         @db.Decimal(12, 2)
  paymentStatus    PaymentStatus   @default(PENDING)
  deliveryStatus   DeliveryStatus  @default(PENDING)
  createdById      String
  createdBy        User            @relation(fields: [createdById], references: [id])
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items            SaleOrderItem[]

  @@index([orderNumber])
  @@index([shopId])
}

model SaleOrderItem {
  id              String    @id @default(uuid())
  orderId         String
  order           SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  quantity        Int
  publicListPrice Decimal   @db.Decimal(10, 2)
  negotiatedPrice Decimal   @db.Decimal(10, 2)
  totalAmount     Decimal   @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(STAFF)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  createdOrders SaleOrder[]
  auditLogs     StockAuditLog[]
}

model StockAuditLog {
  id             String      @id @default(uuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id])
  previousStatus StockStatus
  newStatus      StockStatus
  verifiedById   String
  verifiedBy     User        @relation(fields: [verifiedById], references: [id])
  notes          String?
  checkedAt      DateTime    @default(now())

  @@index([productId])
  @@index([checkedAt])
}

model Enquiry {
  id           String        @id @default(uuid())
  customerName String
  phone        String
  productCode  String?
  message      String?
  source       EnquirySource @default(WHATSAPP)
  createdAt    DateTime      @default(now())

  @@index([phone])
  @@index([productCode])
}
