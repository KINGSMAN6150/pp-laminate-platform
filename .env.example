# ==============================================================================
# Pawan Putra Laminate Platform — Root Environment Example
# Copy this file to .env.local for local development (do NOT commit .env files)
# ==============================================================================

# API Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000/api/v1

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pp_laminate_dev?schema=public"

# Public Web Application
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_COMPANY_NAME="Pawanputra Laminate"
NEXT_PUBLIC_MARKET_LOCATION="Surat, Gujarat, India"

# Internal ERP Application
NEXT_PUBLIC_ERP_API_URL=http://localhost:4000/api/v1
ERP_SESSION_SECRET="replace-with-a-secure-random-secret-in-production"
